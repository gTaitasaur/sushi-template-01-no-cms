---
interface Props {
  variant?: 'primary' | 'secondary';
  class?: string;
  [key: string]: any;
}

const { variant = 'primary', class: className = '', ...rest } = Astro.props;
---
<span class={`badge badge-${variant} ${className}`} {...rest}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: 4px; /* Consistent corner-radius lock */
    line-height: 1;
    width: fit-content;
  }

  .badge-primary {
    background-color: var(--color-primary); /* Rojo linterna */
    color: var(--color-text);
  }

  .badge-secondary {
    background-color: var(--color-secondary); /* Amarillo neón */
    color: var(--color-black);
  }
</style>

