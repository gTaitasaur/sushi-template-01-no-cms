---
// Componente de Carrito de Compras: Drawer y bottom-sheet responsivo con checkout por WhatsApp
---

<!-- Fondo oscuro traslúcido -->
<div class="cart-overlay" id="cart-overlay" role="presentation"></div>

<!-- Drawer / Bottom Sheet -->
<div
  class="cart-drawer"
  id="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Carrito de compras"
>
  <div class="cart-drawer-header">
    <h2 class="cart-drawer-title">Tu Pedido</h2>
    <button class="cart-drawer-close" id="cart-close-btn" aria-label="Cerrar carrito">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="cart-drawer-body">
    <!-- Estado Vacío -->
    <div class="cart-empty-state" id="cart-empty-state">
      <div class="cart-empty-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
        </svg>
      </div>
      <p class="cart-empty-text">Tu pedido está vacío</p>
      <button class="cart-empty-cta-btn" id="cart-explore-btn">Ver la Carta</button>
    </div>

    <!-- Contenedor de Ítems -->
    <div class="cart-items-container hidden" id="cart-items-container">
      <div class="cart-items-list" id="cart-items-list">
        <!-- Renderizado dinámico desde JS -->
      </div>
    </div>
  </div>

  <!-- Pie del Carrito -->
  <div class="cart-drawer-footer hidden" id="cart-drawer-footer">
    <div class="cart-total-row">
      <span class="total-label">Total a pagar:</span>
      <span class="total-value" id="cart-total-value">$0</span>
    </div>
    <p class="cart-checkout-note">Al confirmar, te redirigiremos a WhatsApp con tu pedido detallado para coordinar la entrega y el pago.</p>
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="cart-checkout-btn"
      id="cart-checkout-btn"
    >
      <span>Enviar Pedido por WhatsApp</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </a>
  </div>
</div>

<style>
  /* Fondo Oscuro / Overlay */
  .cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 140;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(body.cart-open) .cart-overlay {
    backdrop-filter: blur(4px);
    opacity: 1;
    pointer-events: auto;
  }

  /* Contenedor Principal del Drawer */
  .cart-drawer {
    position: fixed;
    background-color: var(--color-card-bg);
    border-left: 1px solid var(--color-card-border);
    z-index: 150;
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);

    /* Desktop/Tablet: Lateral Derecho */
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    max-width: 100vw;
    transform: translateX(100%);
  }

  :global(body.cart-open) .cart-drawer {
    transform: translateX(0);
  }

  /* Móvil: Bottom Sheet */
  @media (max-width: 767px) {
    .cart-drawer {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 82vh;
      max-height: 82vh;
      border-left: none;
      border-top: 1px solid var(--color-card-border);
      border-radius: 12px 12px 0 0;
      transform: translateY(100%);
      overscroll-behavior: contain;
    }

    :global(body.cart-open) .cart-drawer {
      transform: translateY(0);
    }
  }

  /* Cabecera del Drawer */
  .cart-drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-card-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-drawer-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-text);
    margin: 0;
  }

  .cart-drawer-close {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.2s, background-color 0.2s;
  }

  .cart-drawer-close:hover {
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .cart-drawer-close:focus-visible {
    outline: 2px solid var(--color-secondary);
  }

  /* Cuerpo del Drawer */
  .cart-drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  /* Estado Vacío */
  .cart-empty-state {
    margin: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
  }

  .cart-empty-icon {
    color: var(--color-text-muted);
    opacity: 0.5;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .cart-empty-text {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .cart-empty-cta-btn {
    background: none;
    border: 1px solid var(--color-secondary);
    color: var(--color-secondary);
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
  }

  .cart-empty-cta-btn:hover {
    background-color: var(--color-secondary);
    color: var(--color-bg);
  }

  .cart-empty-cta-btn:active {
    transform: scale(0.97);
  }

  /* Lista de Ítems */
  .cart-items-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
  }

  /* Ítem Individual */
  :global(.cart-item) {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-card-border);
    animation: fadeInItem 0.25s ease-out;
  }

  @keyframes fadeInItem {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.cart-item:last-child) {
    border-bottom: none;
  }

  :global(.cart-item-img) {
    width: 52px;
    height: 52px;
    border-radius: 4px;
    object-fit: cover;
    border: 1px solid var(--color-card-border);
    flex-shrink: 0;
    background-color: var(--color-black);
  }

  :global(.cart-item-details) {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.cart-item-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  :global(.cart-item-name) {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.25;
  }

  :global(.cart-item-remove) {
    background: none;
    border: none;
    color: var(--color-text-muted);
    opacity: 0.6;
    cursor: pointer;
    padding: 0.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: opacity 0.2s, color 0.2s;
  }

  :global(.cart-item-remove:hover) {
    opacity: 1;
    color: var(--color-primary);
  }

  :global(.cart-item-meta) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.15rem;
  }

  :global(.cart-item-qty-actions) {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-card-border);
    border-radius: 4px;
    overflow: hidden;
  }

  :global(.qty-btn) {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    color: var(--color-text);
    font-size: 0.85rem;
    width: 26px;
    height: 26px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
    user-select: none;
  }

  :global(.qty-btn:hover) {
    background-color: rgba(255, 255, 255, 0.07);
  }

  :global(.qty-btn:disabled) {
    opacity: 0.25;
    cursor: not-allowed;
    background-color: transparent;
  }

  :global(.qty-val) {
    font-size: 0.85rem;
    min-width: 22px;
    text-align: center;
    font-weight: 500;
    user-select: none;
  }

  :global(.cart-item-pricing) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  :global(.unit-price) {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  :global(.subtotal-price) {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  /* Pie del Drawer */
  .cart-drawer-footer {
    padding: 1.25rem 1.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--color-card-border);
    background-color: var(--color-card-bg);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cart-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .total-label {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .total-value {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .cart-checkout-btn {
    background-color: var(--color-primary);
    color: var(--color-text);
    text-decoration: none;
    padding: 0.85rem 1.25rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(200, 62, 49, 0.3);
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
    text-align: center;
  }

  .cart-checkout-btn:hover {
    background-color: #B52F23;
    box-shadow: 0 6px 20px rgba(200, 62, 49, 0.45);
  }

  .cart-checkout-btn:active {
    transform: scale(0.98);
  }

  .cart-checkout-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    text-align: center;
    margin: 0;
    margin-top: -0.25rem;
  }

  .cart-checkout-btn:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  .hidden {
    display: none !important;
  }

  :global(body.cart-open) {
    overflow: hidden;
  }

  .cart-item-specs {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: rgba(255, 255, 255, 0.02);
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    border-left: 2px solid var(--color-secondary);
    margin: 0.25rem 0;
  }

  .cart-item-specs strong {
    color: var(--color-text);
  }
</style>

<!-- Lógica del Carrito (Vanilla JS) -->
<script>
  const PLACEHOLDER_IMG = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23241c1a'/><path d='M35 45a5 5 0 100-10 5 5 0 000 10zM25 70h50L60 50 45 65l-10-10z' fill='%233a2f2b'/></svg>";
  let cart: Array<{id: string, name: string, price: number, image: string, quantity: number, isCustom: boolean, customDetails: {envoltura: string, rellenos: string[], topping: string} | null}> = [];
  const WHATSAPP_PHONE = '56954973890';

  // Referencias del DOM
  const overlay = document.getElementById('cart-overlay');
  const drawer = document.getElementById('cart-drawer');
  const closeBtn = document.getElementById('cart-close-btn');
  const exploreBtn = document.getElementById('cart-explore-btn');
  const emptyState = document.getElementById('cart-empty-state');
  const itemsContainer = document.getElementById('cart-items-container');
  const itemsList = document.getElementById('cart-items-list');
  const footer = document.getElementById('cart-drawer-footer');
  const totalValue = document.getElementById('cart-total-value');
  const checkoutBtn = document.getElementById('cart-checkout-btn');

  // Referencias externas (se cargan al inicializar)
  let headerCartBtn: HTMLElement | null = null;
  let headerCartBadge: HTMLElement | null = null;
  let lastActiveElement: Element | null = null;

  // Inicializar
  function initCart() {
    headerCartBtn = document.getElementById('cart-toggle-btn');
    headerCartBadge = document.getElementById('cart-badge');

    // Cargar desde localStorage
    const stored = localStorage.getItem('sushicart');
    if (stored) {
      try {
        cart = JSON.parse(stored);
      } catch (e) {
        cart = [];
      }
    }

    // Configurar Escuchadores de Apertura/Cierre
    if (headerCartBtn) {
      headerCartBtn.addEventListener('click', openCart);
    }
    if (closeBtn) {
      closeBtn.addEventListener('click', closeCart);
    }
    if (overlay) {
      overlay.addEventListener('click', closeCart);
    }
    if (exploreBtn) {
      exploreBtn.addEventListener('click', () => {
        closeCart();
        const menuEl = document.getElementById('menu');
        if (menuEl) {
          menuEl.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Delegación de eventos para botones del Menú (Agregar)
    document.body.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.menu-item-btn');
      if (btn) {
        // Ignorar si el botón está deshabilitado
        if (btn.hasAttribute('disabled')) {
          e.preventDefault();
          return;
        }

        e.preventDefault();
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const price = btn.getAttribute('data-price');
        const image = btn.getAttribute('data-image');

        const isCustom = btn.getAttribute('data-is-custom') === 'true';
        const envoltura = btn.getAttribute('data-envoltura') || '';
        const rellenosStr = btn.getAttribute('data-rellenos');
        const rellenos = rellenosStr ? JSON.parse(rellenosStr) : [];
        const topping = btn.getAttribute('data-topping') || '';

        if (id && name && price) {
          addToCart(
            id, 
            name, 
            price, 
            image, 
            isCustom, 
            isCustom ? { envoltura, rellenos, topping } : null
          );
        }
      }
    });

    // Delegación de eventos internos del Carrito (Cantidad / Eliminar)
    if (itemsList) {
      itemsList.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        const itemEl = target.closest('.cart-item');
        if (!itemEl) return;
        
        const id = itemEl.getAttribute('data-id');
        if (!id) return;

        if (target.closest('.dec-qty')) {
          updateQuantity(id, -1);
        } else if (target.closest('.inc-qty')) {
          updateQuantity(id, 1);
        } else if (target.closest('.cart-item-remove')) {
          removeFromCart(id);
        }
      });
    }

    // Escuchar teclado para accesibilidad
    document.addEventListener('keydown', handleKeydowns);

    // Renderizado Inicial
    updateCartUI();
  }

  // Abrir Carrito (Focus Trap & State)
  function openCart() {
    lastActiveElement = document.activeElement;
    document.body.classList.add('cart-open');
    if (drawer) drawer.setAttribute('aria-hidden', 'false');
    updateCartUI();

    // Mover foco al botón de cerrar
    setTimeout(() => {
      if (closeBtn) closeBtn.focus();
    }, 100);
  }

  // Cerrar Carrito
  function closeCart() {
    document.body.classList.remove('cart-open');
    if (drawer) drawer.setAttribute('aria-hidden', 'true');

    // Devolver el foco al disparador original
    if (lastActiveElement) {
      (lastActiveElement as HTMLElement).focus();
    }
  }

  // Manejo de Accesibilidad de Teclado
  function handleKeydowns(e: KeyboardEvent) {
    if (!document.body.classList.contains('cart-open')) return;

    // Cierre con Escape
    if (e.key === 'Escape') {
      closeCart();
      return;
    }

    // Focus Trap para Tabulación
    if (e.key === 'Tab') {
      if (!drawer) return;
      const focusables = drawer.querySelectorAll('button:not(:disabled), a, [tabindex="0"]');
      if (focusables.length === 0) return;

      const first = focusables[0] as HTMLElement;
      const last = focusables[focusables.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === first) {
          last.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    }
  }

  // Añadir ítem al carrito
  function addToCart(id: string, name: string, price: string, image: string | null, isCustom: boolean = false, customDetails: {envoltura: string, rellenos: string[], topping: string} | null = null) {
    const parsedPrice = parseInt(price, 10);
    const existing = cart.find(item => item.id === id);

    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({
        id,
        name,
        price: parsedPrice,
        image: image || PLACEHOLDER_IMG,
        quantity: 1,
        isCustom,
        customDetails
      });
    }

    saveCart();
    updateCartUI();
    triggerBadgePop();
  }

  // Modificar cantidades (+/-)
  function updateQuantity(id: string, delta: number) {
    const item = cart.find(item => item.id === id);
    if (!item) return;

    item.quantity += delta;
    if (item.quantity < 1) {
      item.quantity = 1;
    }

    saveCart();
    updateCartUI();
  }

  // Quitar ítem por completo
  function removeFromCart(id: string) {
    cart = cart.filter(item => item.id !== id);
    saveCart();
    updateCartUI();
  }

  // Guardar en almacenamiento local
  function saveCart() {
    localStorage.setItem('sushicart', JSON.stringify(cart));
  }

  // Micro-animación "pop" en el Header Badge
  function triggerBadgePop() {
    if (!headerCartBadge) return;

    // Respetar prefers-reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    headerCartBadge.classList.remove('badge-pop');
    void headerCartBadge.offsetWidth; // Trigger reflow para reiniciar CSS animation
    headerCartBadge.classList.add('badge-pop');
  }

  // Actualizar los elementos gráficos de la interfaz
  function updateCartUI() {
    // 1. Contador del Badge en Header
    let totalItems = 0;
    let totalCash = 0;

    cart.forEach(item => {
      totalItems += item.quantity;
      totalCash += item.price * item.quantity;
    });

    if (headerCartBadge) {
      headerCartBadge.textContent = totalItems.toString();
      if (totalItems > 0) {
        headerCartBadge.classList.add('visible');
      } else {
        headerCartBadge.classList.remove('visible');
      }
    }

    // 2. Visibilidad de estados (Vacío vs Poblado)
    if (emptyState && itemsContainer && footer && itemsList) {
      if (cart.length === 0) {
        emptyState.classList.remove('hidden');
        itemsContainer.classList.add('hidden');
        footer.classList.add('hidden');
      } else {
        emptyState.classList.add('hidden');
        itemsContainer.classList.remove('hidden');
        footer.classList.remove('hidden');

        // Actualizar listado de items
        itemsList.innerHTML = cart.map(item => {
        const specsHtml = item.isCustom && item.customDetails ? `
          <div class="cart-item-specs">
            <span><strong>Envoltura:</strong> ${item.customDetails.envoltura}</span>
            <span><strong>Rellenos:</strong> ${item.customDetails.rellenos.join(', ')}</span>
            <span><strong>Topping:</strong> ${item.customDetails.topping}</span>
          </div>
        ` : '';

        return `
          <div class="cart-item" data-id="${item.id}">
            <img src="${item.image}" alt="${item.name}" class="cart-item-img" onerror="this.src='${PLACEHOLDER_IMG}';" />
            <div class="cart-item-details">
              <div class="cart-item-header">
                <span class="cart-item-name">${item.name}</span>
                <button class="cart-item-remove" aria-label="Eliminar ${item.name}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </div>
              ${specsHtml}
              <div class="cart-item-meta">
                <div class="cart-item-qty-actions">
                  <button class="qty-btn dec-qty" ${item.quantity === 1 ? 'disabled' : ''} aria-label="Reducir cantidad de ${item.name}">-</button>
                  <span class="qty-val" aria-label="Cantidad">${item.quantity}</span>
                  <button class="qty-btn inc-qty" aria-label="Aumentar cantidad de ${item.name}">+</button>
                </div>
                <div class="cart-item-pricing">
                  <span class="unit-price">$${item.price.toLocaleString('es-CL')} c/u</span>
                  <span class="subtotal-price" aria-label="Subtotal">$${(item.price * item.quantity).toLocaleString('es-CL')}</span>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Actualizar Total
      if (totalValue) {
        totalValue.textContent = `$${totalCash.toLocaleString('es-CL')}`;
      }

      // Actualizar enlace de WhatsApp
      if (checkoutBtn) {
        checkoutBtn.setAttribute('href', buildWhatsappLink(totalCash));
      }
    }
  }
}

  // Compilar y codificar el pedido de WhatsApp
  function buildWhatsappLink(total: number) {
    let msg = `*NUEVO PEDIDO — Tu Tienda Sushi*\n\n`;
    msg += `*Detalle de la compra:*\n`;
    msg += `-------------------------------------------\n`;

    cart.forEach(item => {
      const subtotal = item.price * item.quantity;
      msg += `• *${item.quantity}x* ${item.name}\n`;
      if (item.isCustom && item.customDetails) {
        msg += `   - *Envoltura:* ${item.customDetails.envoltura}\n`;
        msg += `   - *Rellenos:* ${item.customDetails.rellenos.join(', ')}\n`;
        msg += `   - *Topping:* ${item.customDetails.topping}\n`;
      }
      msg += `  $${item.price.toLocaleString('es-CL')} c/u — Subtotal: $${subtotal.toLocaleString('es-CL')}\n\n`;
    });

    msg += `-------------------------------------------\n`;
    msg += `*Total a Pagar:* $${total.toLocaleString('es-CL')}\n\n`;
    msg += `¿Podría confirmar mi pedido y entregarme un tiempo estimado de espera? ¡Muchas gracias!`;

    const encoded = encodeURIComponent(msg);
    return `https://wa.me/${WHATSAPP_PHONE}?text=${encoded}`;
  }

  // Arrancar lógica al cargar la página
  document.addEventListener('DOMContentLoaded', initCart);
  // Compatibilidad con transiciones de página de Astro
  document.addEventListener('astro:page-load', initCart);
</script>

<style is:global>
  /* Animación Pop de la Bolsa del Carrito */
  .badge-pop {
    animation: badgePopAnim 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes badgePopAnim {
    0% { transform: scale(1); }
    50% { transform: scale(1.45) rotate(-8deg); }
    100% { transform: scale(1); }
  }
</style>
