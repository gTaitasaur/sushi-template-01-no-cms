# ============================================================
# Plantilla de variables de entorno — Sushi Landing Template
# ============================================================
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
#
# En Cloudflare Workers Builds, define estas mismas variables
# en el dashboard (Settings > Environment Variables).

# URL del sitio (usado para sitemap, OG images y canonical)
SITE_URL=https://sushi-template-01-no-cms.gtaitasaur.workers.dev

# Google Analytics Measurement ID (formato: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=G-TEST123456

# Nombre del sitio (usado en SEO <title> y meta tags)
# Si no se define, usa "Sushi Landing" por defecto
PUBLIC_SITE_TITLE=

# Descripción del sitio (usado en SEO <meta name="description">)
# Si no se define, usa la descripción por defecto
PUBLIC_SITE_DESCRIPTION=
